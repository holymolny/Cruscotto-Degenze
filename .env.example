# -----------------------------------------------------------------------
# Modello del file di configurazione.
# Copia questo file con il nome ".env" e riempi i valori.
# Il .env NON finisce su Git (lo esclude .gitignore); questo esempio sì.
# -----------------------------------------------------------------------

# Chiave con cui vengono firmati i cookie di sessione: deve essere lunga e
# casuale. Se la cambi, tutti gli utenti collegati devono rifare l'accesso.
# Per generarne una nuova:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Quale configurazione usare: sviluppo | test | produzione
FLASK_CONFIG=sviluppo

# Dove si trova il database.
# Fase 1 (locale): lascia vuoto, viene usato il file cruscotto.db nella
#                  cartella del progetto.
# Fase 2 (VM):     mssql+pyodbc://utente:password@sql-misnav/CruscottoDegenze?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=

# Minuti di inattività dopo i quali l'utente viene disconnesso.
# I PC di reparto sono condivisi, quindi la sessione non deve restare aperta.
MINUTI_INATTIVITA=15

# Dice al comando "flask" quale file contiene l'applicazione.
FLASK_APP=wsgi.py
